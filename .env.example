# ─────────────────────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Public-facing hostname used to build wss:// URLs for Twilio Media Streams.
# Use ngrok or similar for local dev: HOST=abc123.ngrok.io
HOST=your-public-hostname.com

# ─────────────────────────────────────────────────────────────────────────────
# Database (Postgres)
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://dental:secret@localhost:5432/dental_ai
# Used by docker-compose files individually
POSTGRES_USER=dental
POSTGRES_PASSWORD=secret
POSTGRES_DB=dental_ai

# ─────────────────────────────────────────────────────────────────────────────
# Twilio
# ─────────────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_NUMBER=+1xxxxxxxxxx
# Webhook secret for HMAC-SHA256 signature validation on GHL payloads
GHL_WEBHOOK_SECRET=your_ghl_webhook_secret

# ─────────────────────────────────────────────────────────────────────────────
# OpenAI (Whisper STT + GPT-4o)
# ─────────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────────────────────
# ElevenLabs TTS
# ─────────────────────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=your_elevenlabs_api_key
# Voice ID for "Nova" — find yours at elevenlabs.io/voice-lab
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# ─────────────────────────────────────────────────────────────────────────────
# GoHighLevel (GHL)
# ─────────────────────────────────────────────────────────────────────────────
GHL_API_KEY=your_ghl_api_key
GHL_LOCATION_ID=your_ghl_location_id
# Calendar ID used when booking appointments via GHL API
GHL_CALENDAR_ID=your_ghl_calendar_id
